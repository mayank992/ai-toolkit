#!/usr/bin/env python3
"""ait: the ai-toolkit CLI. On the Bash tool's PATH while the plugin is enabled; link it into
~/.local/bin (or `uv tool install .`) to use it from your own terminal."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "src"))

from ai_toolkit.cli import main  # noqa: E402

main()
