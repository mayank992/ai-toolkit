#!/usr/bin/env python3
"""ai-rules: see every rule that shapes Claude Code in a project, and gather evidence after a merge.

  ai-rules show [PROJECT] [--json]          the rule stack: instructions, memory, hooks, lessons, problems
  ai-rules projects                         projects with any rules, most recent first
  ai-rules retro-data MR [--project DIR]    gather MR evidence for /mr-retro; prints the JSON path
  ai-rules retro-log MR --proposed N --applied N [--note TEXT] [--project DIR]
  ai-rules fire HOOK DECISION [--project DIR]   append to the hook-fire log (for hook scripts)
  ai-rules snapshot                         dashboard JSON
"""
import argparse
import json
import os
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "lib"))

import inventory as inv  # noqa: E402


def project_arg(p):
    d = os.path.abspath(os.path.expanduser(p or os.getcwd()))
    rc, top = inv.git(d, "rev-parse", "--show-toplevel")
    if rc != 0 or not top:
        return inv.canonical(d)
    up = os.path.relpath(os.path.realpath(d), os.path.realpath(top))
    if up == "." or up.startswith(".."):
        return inv.canonical(d if up == "." else top)
    return inv.canonical(os.path.normpath(os.path.join(d, *[".."] * len(up.split(os.sep)))))


def cmd_show(a):
    v = inv.project_view(project_arg(a.project))
    if a.json:
        print(json.dumps(v, indent=2))
        return
    print("%s  %s" % (v["path"], v["repo"] or ""))
    print("\nInstructions")
    for f in v["instructions"]:
        print("  %-8s %-55s %3d lines  git:%s" % (f["scope"], f["path"].replace(inv.home(), "~"), f["lines"], f["git"]))
    print("\nMemory (%d)" % len(v["memory"]["notes"]))
    for n in v["memory"]["notes"]:
        print("  %s %-38s %s" % (" " if n["indexed"] else "!", n["name"][:38], n["description"][:80]))
    print("\nHooks (%d)" % len(v["hooks"]))
    for h in v["hooks"]:
        f = h["fires"]["count"]
        print("  %-7s %-16s %-6s %-24s %s" % (h["scope"], h["event"], h["matcher"] or "*", h["name"][:24],
                                              ("%d fires" % f) if h["logged"] else "not logged"))
    print("\nLessons (%d)" % len(v["lessons"]))
    for l in v["lessons"]:
        print("  %s %-9s %s" % (l["id"], l["status"], l["text"][:90]))
    if v["problems"]:
        print("\nProblems")
        for p in v["problems"]:
            print("  [%s] %s  (%s)" % (p["level"], p["text"], p["where"].replace(inv.home(), "~")))
    if v["overlaps"]:
        print("\nPossible overlaps")
        for o in v["overlaps"][:10]:
            print("  %.2f  %s: %s  <->  %s: %s" % (o["score"], o["a"]["layer"], o["a"]["name"][:40], o["b"]["layer"], o["b"]["name"][:40]))


def cmd_projects(a):
    for p in inv.projects():
        print(p)


def cmd_retro_data(a):
    import retro
    path, out = retro.gather(project_arg(a.project), a.mr)
    s, sh = out["summary"], out.get("share") or {}
    print(path)
    print("%s: %d sessions, %d prompts (%d pushback), threads %s, CC share %s%% (src %s%%, tests %s%%)" % (
        out["meta"]["title"], s["sessions"], s["prompts"], s["pushback"], s["threads"],
        sh.get("cc_pct"), sh.get("src_pct"), sh.get("test_pct")))


def cmd_retro_log(a):
    import retro
    e = retro.log(project_arg(a.project), a.mr, a.proposed, a.applied, a.note or "")
    print(json.dumps(e))


def cmd_fire(a):
    os.makedirs(inv.state_dir(), exist_ok=True)
    with open(inv.state_dir("fires.jsonl"), "a") as f:
        f.write(json.dumps({"t": int(time.time()), "hook": a.hook, "decision": a.decision,
                            "project": project_arg(a.project)}) + "\n")


def cmd_snapshot(a):
    print(json.dumps(inv.snapshot()))


def main():
    ap = argparse.ArgumentParser(prog="ai-rules", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")
    p = sub.add_parser("show"); p.add_argument("project", nargs="?"); p.add_argument("--json", action="store_true"); p.set_defaults(f=cmd_show)
    p = sub.add_parser("projects"); p.set_defaults(f=cmd_projects)
    p = sub.add_parser("retro-data"); p.add_argument("mr"); p.add_argument("--project"); p.set_defaults(f=cmd_retro_data)
    p = sub.add_parser("retro-log"); p.add_argument("mr"); p.add_argument("--project")
    p.add_argument("--proposed", type=int, default=0); p.add_argument("--applied", type=int, default=0); p.add_argument("--note")
    p.set_defaults(f=cmd_retro_log)
    p = sub.add_parser("fire"); p.add_argument("hook"); p.add_argument("decision"); p.add_argument("--project"); p.set_defaults(f=cmd_fire)
    p = sub.add_parser("snapshot"); p.set_defaults(f=cmd_snapshot)
    a = ap.parse_args()
    if not getattr(a, "f", None):
        ap.print_help()
        return
    a.f(a)


if __name__ == "__main__":
    main()
