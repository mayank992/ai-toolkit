#!/usr/bin/env python3
"""Transitional shim for pre-0.2 installs (~/.local/bin links here). Same as: ait setup ..."""
import os
import sys

root = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__)))))
os.execv(sys.executable, [sys.executable, os.path.join(root, "bin", "ait"), "setup"] + sys.argv[1:])
